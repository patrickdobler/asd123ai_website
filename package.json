{
  "name": "asd123-ai-website",
  "version": "1.0.0",
  "description": "ASD123.ai - Privacy-First AI Text Processing Tools",
  "main": "src/index.js",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build-dev.js",
    "dev": "concurrently \"node build-dev.js\" \"wrangler dev\" --names \"watch,wrangler\" --prefix-colors \"blue,magenta\"",
    "dev:watch": "node build-dev.js",
    "dev:server": "wrangler dev",
    "deploy": "npx -y wrangler@4.32.0 deploy --env production"
  },
  "devDependencies": {
    "clean-css": "^5.3.2",
    "concurrently": "^9.2.1",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.24.0",
    "wrangler": "^4.32.0"
  },
  "keywords": [
    "AI",
    "text processing",
    "privacy",
    "Swiss",
    "optimizer",
    "cloudflare workers"
  ],
  "author": "ASD123.ai",
  "license": "MIT"
}
